# Service account for unauthenticated visitors.
# Almost every backend RPC requires auth, so we log in as a dedicated
# account for guest page views (feed, posts, comments, fandoms, etc.)
# and pass its access token through. The account MUST NOT have 2FA
# enabled. Tokens are cached at .service-account-tokens.json (gitignored,
# chmod 0600) so the server doesn't re-login on every cold start.
SERVICE_ACCOUNT_EMAIL="bot@example.com"
SERVICE_ACCOUNT_PASSWORD="..."

# A secret string to use for issuing JWTs in PushRelay.
JWT_SECRET="funny_secret_here"

# Redis server used for storing the state and pushing
# notifications in PushRelay.
REDIS_URL="redis://127.0.0.1"
