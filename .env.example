# Service account for unauthenticated visitors.
# Almost every backend RPC requires auth, so we use a dedicated account
# for guest page views (feed, posts, comments, fandoms, etc.) and pass
# its access token through. Provide a long-lived refresh token obtained
# by logging in once with this account; loginRefresh does not rotate it,
# so the same value works across restarts and machines. The access token
# is cached in process memory only.
SERVICE_ACCOUNT_REFRESH_TOKEN="..."

# A secret string to use for issuing JWTs in PushRelay.
JWT_SECRET="funny_secret_here"

# Redis server used for storing the state and pushing
# notifications in PushRelay.
REDIS_URL="redis://127.0.0.1"
